#!/bin/bash
# Deskie launcher, run by the SessionStart hook (and, with --on-prompt, by the async UserPromptSubmit hook).
#
# Fast path (a few ms): exit if the app answers /health, or if
# ~/.desk-buddy/settings.json has "startWithClaude": false.
# Otherwise a detached background job installs the app if needed and starts it with
# `open -g` (no focus steal), so Claude never waits on a download.
#
# Always exits 0. Progress goes to ~/.desk-buddy/launcher.log. It prints (a `systemMessage`, shown in the
# transcript, never added to context) only: on a first install or update ("setting things up"), once when the
# download failed (404, offline or a checksum mismatch, told at the next session start), and once ever on a Mac older than macOS 13.
#
# Overrides (for development and tests):
#   DESK_BUDDY_DEV_APP=/path/Deskie.app   launch this bundle as is, no install
#   DESK_BUDDY_DEV_APP=/path/to/source/app       run the source checkout with its local Electron
#   DESK_BUDDY_DEV_APP=/path/to/Desk-Buddy.zip  install from this zip (no checksum check)
#   DESK_BUDDY_RELEASE_URL=http://127.0.0.1:8000/{file}   release URL template ({version}, {file})
#   DESK_BUDDY_APPS_DIR=/some/dir              install here instead of ~/Applications
#   DESK_BUDDY_HOME=/some/dir                  instead of ~/.desk-buddy (passed on to the app)
#   DESK_BUDDY_LAUNCHER_FOREGROUND=1           do the work in the foreground (tests)
#   DESK_BUDDY_OPEN_CMD, DESK_BUDDY_HEALTH_WAIT  replace `open` and the 20 s health wait (tests)
#   DESK_BUDDY_PROMPT_EVERY=180                --on-prompt: seconds between two checks (tests)
#
# --on-prompt (UserPromptSubmit, async): brings back a quit or crashed Deskie on the next message. At most one check
# every 3 minutes (the mtime of ~/.desk-buddy/prompt-check), and only when the app is already installed: it never
# downloads or updates (SessionStart does that), so an Uninstall from the menu is never undone by a chat that still
# has the plugin loaded. A Quit from Deskie's menu is respected too: it leaves ~/.desk-buddy/quit-by-user, and while
# that exists the on-prompt check does nothing. A session start (no --on-prompt) clears it and starts Deskie, as the
# quit dialog says; so only a crash or another unexpected exit comes back on the next message. Prints nothing.

[ "${DESK_BUDDY_CLASSIFIER:-}" = "1" ] && exit 0

exec 3>&1 >/dev/null 2>&1 </dev/null   # fd 3 = the hook's real stdout, used only for the setup message
umask 022

PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HOME_DIR="${DESK_BUDDY_HOME:-$HOME/.desk-buddy}"
APPS_DIR="${DESK_BUDDY_APPS_DIR:-$HOME/Applications}"
APP_NAME="Deskie.app"
APP="$APPS_DIR/$APP_NAME"

ENV_RELEASE_URL="${DESK_BUDDY_RELEASE_URL:-}"
# shellcheck source=config.sh disable=SC1091
. "$PLUGIN_DIR/config.sh"
[ -n "$ENV_RELEASE_URL" ] && DESK_BUDDY_RELEASE_URL="$ENV_RELEASE_URL"
PINNED="$DESK_BUDDY_APP_VERSION"

if [ -f "$HOME_DIR/settings.json" ] && grep -Eq '"startWithClaude"[[:space:]]*:[[:space:]]*false' "$HOME_DIR/settings.json"; then
  exit 0
fi

healthy() {
  local port=""
  [ -r "$HOME_DIR/port" ] && read -r port < "$HOME_DIR/port"
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  curl -s -m 1 "http://127.0.0.1:$port/health" 2>/dev/null | grep -q '"ok":true'
}

ON_PROMPT=0
if [ "${1:-}" = "--on-prompt" ]; then
  ON_PROMPT=1
  [ -d "$APP" ] || [ -n "${DESK_BUDDY_DEV_APP:-}" ] || exit 0
  [ -e "$HOME_DIR/quit-by-user" ] && exit 0
  _stamp="$HOME_DIR/prompt-check"
  _every="${DESK_BUDDY_PROMPT_EVERY:-180}"
  case "$_every" in ''|*[!0-9]*) _every=180 ;; esac
  if [ -f "$_stamp" ]; then
    _age=$(( $(date +%s) - $(stat -f %m "$_stamp" 2>/dev/null || echo 0) ))
    [ "$_age" -ge 0 ] && [ "$_age" -lt "$_every" ] && exit 0
  fi
  mkdir -p "$HOME_DIR" && : > "$_stamp"
  exec 3>/dev/null   # never a systemMessage from a prompt
else
  rm -f "$HOME_DIR/quit-by-user"   # a session start: Deskie starts again, as the quit dialog says
fi

healthy && exit 0

log() {
  mkdir -p "$HOME_DIR"
  local f="$HOME_DIR/launcher.log"
  if [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 200000 ]; then mv -f "$f" "$f.1"; fi
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >> "$f"
}

# 0 if $1 < $2 (numeric x.y.z, pre-release suffix ignored)
version_lt() {
  local a="${1%%[-+]*}" b="${2%%[-+]*}" i x y
  local -a av bv
  IFS=. read -r -a av <<< "$a"
  IFS=. read -r -a bv <<< "$b"
  for i in 0 1 2; do
    x="${av[$i]:-0}"; y="${bv[$i]:-0}"
    case "$x" in ''|*[!0-9]*) x=0 ;; esac
    case "$y" in ''|*[!0-9]*) y=0 ;; esac
    [ "$x" -lt "$y" ] && return 0
    [ "$x" -gt "$y" ] && return 1
  done
  return 1
}

# Deskie needs macOS 13 Ventura or later (Electron's LSMinimumSystemVersion). On an older Mac, download nothing,
# log why and tell the user ONCE (a marker in the Deskie home folder), not in every session. An unreadable version
# is not treated as too old.
if [ -z "${DESK_BUDDY_DEV_APP:-}" ]; then
  MACOS_VERSION="$(sw_vers -productVersion 2>/dev/null)"
  case "$MACOS_VERSION" in
    [0-9]*)
      if version_lt "$MACOS_VERSION" "13.0"; then
        log "skipped: Deskie needs macOS 13 Ventura or later (this Mac has macOS $MACOS_VERSION)"
        if [ ! -e "$HOME_DIR/told-macos-too-old" ]; then
          printf '%s\n' "{\"systemMessage\":\"Deskie needs macOS 13 Ventura or later. This Mac has macOS ${MACOS_VERSION//[^0-9.]/}, so Deskie was not installed.\"}" >&3
          : > "$HOME_DIR/told-macos-too-old"
        fi
        exit 0
      fi ;;
  esac
fi

installed_version() { # prints nothing when there is no app (PlistBuddy reports errors on stdout)
  [ -f "$1/Contents/Info.plist" ] || return 0
  local v
  v="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null)" || return 0
  case "$v" in [0-9]*.[0-9]*) printf '%s' "$v" ;; esac
}

arch_name() {
  # Report arm64 even when this shell runs under Rosetta.
  if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then echo arm64; else echo x64; fi
}

release_url() { # $1 = file name
  local u="${DESK_BUDDY_RELEASE_URL//\{version\}/$PINNED}"
  printf '%s' "${u//\{file\}/$1}"
}

# Install "Deskie.app" from a zip into $APPS_DIR. $1 = zip path.
install_zip() {
  local zip="$1" tmp="$2"
  mkdir -p "$tmp/x"
  if ! ditto -x -k "$zip" "$tmp/x"; then log "unzip failed: $zip"; return 1; fi
  if [ ! -d "$tmp/x/$APP_NAME" ]; then log "zip has no $APP_NAME"; return 1; fi
  xattr -dr com.apple.quarantine "$tmp/x/$APP_NAME" 2>/dev/null
  mkdir -p "$APPS_DIR"
  if [ -e "$APP" ]; then mv "$APP" "$tmp/old.app" || { log "cannot move old app aside"; return 1; }; fi
  if ! mv "$tmp/x/$APP_NAME" "$APP"; then
    log "install failed; restoring the old app"
    [ -e "$tmp/old.app" ] && mv "$tmp/old.app" "$APP"
    return 1
  fi
  if xattr -p com.apple.quarantine "$APP" >/dev/null 2>&1; then log "warning: quarantine attribute present on $APP"; fi
  log "installed $(installed_version "$APP") into $APP"
  return 0
}

# A failed download leaves "<notfound|offline|checksum> <version>" in $FAIL_MARK; the next session start tells the
# user once (see the end of this file). A good install clears it.
FAIL_MARK="$HOME_DIR/download-failed"
TOLD_MARK="$HOME_DIR/download-failed-told"
download_failed() { # $1 = curl's exit code. 22: the server answered an HTTP error (404: no such release); else offline.
  local kind=offline                 # ("checksum": the download didn't match SHA256SUMS)
  [ "$1" = "22" ] && kind=notfound
  [ "$1" = "checksum" ] && kind=checksum
  printf '%s %s\n' "$kind" "$PINNED" > "$FAIL_MARK"
}

download_and_install() {
  local arch file tmp expected actual rc
  arch="$(arch_name)"
  file="Deskie-$PINNED-$arch.zip"
  mkdir -p "$HOME_DIR"
  tmp="$(mktemp -d "$HOME_DIR/download.XXXXXX")" || return 1
  log "downloading $(release_url "$file")"
  curl -fsSL --retry 2 --connect-timeout 10 -m 900 -o "$tmp/$file" "$(release_url "$file")"; rc=$?
  if [ "$rc" != 0 ]; then
    log "download failed (curl $rc)"; download_failed "$rc"; rm -rf "$tmp"; return 1
  fi
  curl -fsSL --retry 2 --connect-timeout 10 -m 60 -o "$tmp/SHA256SUMS" "$(release_url SHA256SUMS)"; rc=$?
  if [ "$rc" != 0 ]; then
    log "SHA256SUMS download failed (curl $rc)"; download_failed "$rc"; rm -rf "$tmp"; return 1
  fi
  expected="$(awk -v f="$file" '$2 == f || $2 == "*" f { print $1; exit }' "$tmp/SHA256SUMS")"
  actual="$(shasum -a 256 "$tmp/$file" | awk '{ print $1 }')"
  if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
    log "checksum mismatch for $file (expected '$expected', got '$actual')"; download_failed checksum; rm -rf "$tmp"; return 1
  fi
  install_zip "$tmp/$file" "$tmp"; rc=$?
  rm -rf "$tmp"
  [ "$rc" = 0 ] && rm -f "$FAIL_MARK" "$TOLD_MARK"
  return $rc
}

# The app must not open Settings when this launcher `open`s it while it is already running (macOS then sends it a
# reopen event, which is what a user's own launch looks like). So the launcher leaves a fresh marker file first,
# and passes --from-launcher to a new instance.
mark_launch() { mkdir -p "$HOME_DIR"; : > "$HOME_DIR/launcher-open"; }

launch_bundle() { # $1 = .app path
  local args=(-g)
  [ -n "${DESK_BUDDY_HOME:-}" ] && args+=(--env "DESK_BUDDY_HOME=$DESK_BUDDY_HOME")
  [ -n "${DESK_BUDDY_PORT:-}" ] && args+=(--env "DESK_BUDDY_PORT=$DESK_BUDDY_PORT")
  log "open ${args[*]} $1"
  mark_launch
  "${DESK_BUDDY_OPEN_CMD:-open}" "${args[@]}" "$1" --args --from-launcher
}

launch_source() { # $1 = source checkout with package.json
  local electron="$1/node_modules/.bin/electron"
  if [ ! -x "$electron" ]; then log "no Electron in $1 (run npm install)"; return 1; fi
  log "starting source checkout $1"
  mark_launch
  (cd "$1" && nohup "$electron" . --from-launcher >/dev/null 2>&1 &)
}

work() {
  lock="$HOME_DIR/launcher.lock"   # global, so the EXIT trap still sees it
  mkdir -p "$HOME_DIR"
  if ! mkdir "$lock" 2>/dev/null; then
    # Another launcher is busy. Take over a lock older than 15 minutes.
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +15 2>/dev/null)" ]; then
      rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 0
    else
      return 0
    fi
  fi
  trap 'rm -rf "$lock"' EXIT

  local dev="${DESK_BUDDY_DEV_APP:-}"
  if [ -n "$dev" ]; then
    case "$dev" in
      *.app|*.app/) launch_bundle "$dev" ;;
      *.zip)
        local tmp; tmp="$(mktemp -d "$HOME_DIR/download.XXXXXX")" || return 0
        install_zip "$dev" "$tmp"; rm -rf "$tmp"
        launch_bundle "$APP" ;;
      *) if [ -f "$dev/package.json" ]; then launch_source "$dev"; else log "DESK_BUDDY_DEV_APP not usable: $dev"; fi ;;
    esac
  else
    local have; have="$(installed_version "$APP")"
    if [ "$ON_PROMPT" != 1 ] && { [ -z "$have" ] || version_lt "$have" "$PINNED"; }; then
      download_and_install || { [ -n "$have" ] || return 0; }
    fi
    [ -d "$APP" ] && launch_bundle "$APP"
  fi

  local i=0 wait="${DESK_BUDDY_HEALTH_WAIT:-20}"
  while :; do
    healthy && { log "app is up"; return 0; }
    [ "$i" -ge "$wait" ] && break
    sleep 1; i=$((i + 1))
  done
  log "app did not answer /health within $wait s"
}

# When this hook prints: a first install or an update is about to download the app, so the user is told why Tom
# isn't there yet. If the last download of this version failed, the user is told that instead, ONCE (with what to
# do), and after that nothing while it keeps retrying quietly. `systemMessage` JSON is shown in the transcript,
# never added to context.
if [ "$ON_PROMPT" != 1 ] && [ -z "${DESK_BUDDY_DEV_APP:-}" ] && [ ! -d "$HOME_DIR/launcher.lock" ]; then
  _have="$(installed_version "$APP")"
  if [ -z "$_have" ] || version_lt "$_have" "$PINNED"; then
    _kind=""; _ver=""
    [ -r "$FAIL_MARK" ] && read -r _kind _ver < "$FAIL_MARK"
    [ "$_ver" = "$PINNED" ] || _kind="" # a marker from another version: stale
    if [ -n "$_kind" ]; then
      if [ "$(cat "$TOLD_MARK" 2>/dev/null)" != "$_kind $_ver" ]; then
        if [ "$_kind" = checksum ]; then
          printf '%s\n' '{"systemMessage":"Deskie: the downloaded app did not match its checksum, so it was not installed. It will try again when you start your next Claude session. If this keeps happening, see launcher.log in the ~/.desk-buddy folder."}' >&3
        elif [ "$_kind" = notfound ]; then
          printf '%s\n' "{\"systemMessage\":\"Deskie: the app download (version ${PINNED//[^0-9A-Za-z.-]/}) is not available on GitHub yet. Run /plugin marketplace update deskie, then start a new Claude session. Deskie keeps trying in the background.\"}" >&3
        else
          printf '%s\n' '{"systemMessage":"Deskie: could not download the app (no internet connection?). It will try again when you start your next Claude session."}' >&3
        fi
        printf '%s %s\n' "$_kind" "$_ver" > "$TOLD_MARK"
      fi
    elif [ -z "$_have" ]; then
      printf '%s\n' '{"systemMessage":"Deskie: setting things up for the first time. Tom will appear in the top-right corner in about a minute."}' >&3
    else
      printf '%s\n' '{"systemMessage":"Deskie: downloading an update in the background."}' >&3
    fi
  fi
fi

exec 3>&-
if [ "${DESK_BUDDY_LAUNCHER_FOREGROUND:-}" = "1" ]; then
  work
else
  # A subshell, so its EXIT trap runs when the work ends and the lock is released (bash 3.2 skips the
  # EXIT trap of a plain `work &` background function).
  ( work ) &
  disown 2>/dev/null
fi
exit 0
